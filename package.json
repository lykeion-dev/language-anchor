  "license": "MIT",
  "author": "Wakaru-kun",
  "repository": {
    "type": "git",
    "url": "https://github.com/wakaru-kun/language-enforcer"
  },
  "openclaw": {
    "extensions": ["./index.js"],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
